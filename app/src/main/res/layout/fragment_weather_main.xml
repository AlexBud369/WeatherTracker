<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- РџРѕРёСЃРєРѕРІР°СЏ СЃС‚СЂРѕРєР° -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_search_bar">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    app:tint="#64748B"
                    android:contentDescription="РџРѕРёСЃРє" />

                <EditText
                    android:id="@+id/etSearchCity"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="РџРѕРёСЃРє РіРѕСЂРѕРґР°..."
                    android:imeOptions="actionSearch"
                    android:inputType="textCapWords"
                    android:paddingHorizontal="8dp"
                    android:textSize="15sp"
                    android:textColor="#1E293B" />

                <Button
                    android:id="@+id/btnSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="РќР°Р№С‚Рё"
                    android:textSize="12sp"
                    android:backgroundTint="#1E88E5" />
            </LinearLayout>

            <!-- РљР°СЂС‚РѕС‡РєР° РёРЅС„РѕСЂРјР°С†РёРё Рѕ РІС‹Р±СЂР°РЅРЅРѕРј РіРѕСЂРѕРґРµ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_location"
                            android:contentDescription="Р›РѕРєР°С†РёСЏ" />

                        <TextView
                            android:id="@+id/tvCityName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="РњРѕСЃРєРІР°"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A" />

                        <TextView
                            android:id="@+id/tvCondition"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="РЇСЃРЅРѕ вЂпёЏ"
                            android:textSize="16sp"
                            android:textColor="#0284C7"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDateTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="РџСЏС‚РЅРёС†Р°, 30 РѕРєС‚СЏР±СЂСЏ, 10:45"
                        android:textSize="13sp"
                        android:textColor="#64748B" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvCurrentTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+18В°C"
                            android:textSize="44sp"
                            android:textStyle="bold"
                            android:textColor="#1E293B" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvFeelsLike"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="РћС‰СѓС‰Р°РµС‚СЃСЏ РєР°Рє +16В°C"
                                android:textSize="14sp"
                                android:textColor="#475569" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="РљРѕРјС„РѕСЂС‚РЅР°СЏ РІР»Р°Р¶РЅРѕСЃС‚СЊ"
                                android:textSize="12sp"
                                android:textColor="#94A3B8" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- РРЅС‚РµСЂР°РєС‚РёРІРЅР°СЏ РєР°СЂС‚Р° (СЃ РІРѕР·РјРѕР¶РЅРѕСЃС‚СЊСЋ СѓРІРµР»РёС‡РёС‚СЊ) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMapPreview"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_map_placeholder">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_map"
                            app:tint="#0369A1"
                            android:contentDescription="РљР°СЂС‚Р°" />

                        <TextView
                            android:id="@+id/tvMapCityTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="РРЅС‚РµСЂР°РєС‚РёРІРЅР°СЏ РєР°СЂС‚Р° РѕСЃР°РґРєРѕРІ: РњРѕСЃРєРІР°"
                            android:textColor="#0369A1"
                            android:textStyle="bold"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="РќР°Р¶РјРёС‚Рµ РґР»СЏ СѓРІРµР»РёС‡РµРЅРёСЏ РїРѕРІРµСЂС… СЌРєСЂР°РЅР°"
                            android:textColor="#0284C7"
                            android:textSize="12sp" />
                    </LinearLayout>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- РњРµС‚СЂРёРєРё РїРѕРіРѕРґС‹ (РІРµС‚РµСЂ, РІР»Р°Р¶РЅРѕСЃС‚СЊ, РґР°РІР»РµРЅРёРµ) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Р’РµС‚РµСЂ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_wind"
                            android:contentDescription="Р’РµС‚РµСЂ" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Р’РµС‚РµСЂ"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvWind"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="4.2 Рј/СЃ"
                            android:textColor="#0F172A"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Р’Р»Р°Р¶РЅРѕСЃС‚СЊ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_humidity"
                            android:contentDescription="Р’Р»Р°Р¶РЅРѕСЃС‚СЊ" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Р’Р»Р°Р¶РЅРѕСЃС‚СЊ"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvHumidity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="65%"
                            android:textColor="#0F172A"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Р”Р°РІР»РµРЅРёРµ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_pressure"
                            android:contentDescription="Р”Р°РІР»РµРЅРёРµ" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Р”Р°РІР»РµРЅРёРµ"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvPressure"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="752 РјРј"
                            android:textColor="#0F172A"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- РљРЅРѕРїРєРё РґРµР№СЃС‚РІРёР№ -->
            <Button
                android:id="@+id/btnShowDetails"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="РџРѕРєР°Р·Р°С‚СЊ РїРѕРґСЂРѕР±РЅРµРµ"
                android:textSize="15sp"
                android:backgroundTint="#1E88E5"
                app:icon="@drawable/ic_forecast"
                app:iconGravity="textStart" />

            <Button
                android:id="@+id/btnAddReview"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="РћСЃС‚Р°РІРёС‚СЊ РѕС‚Р·С‹РІ"
                android:textSize="15sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart" />

            <!-- Р‘Р»РѕРє РїРѕСЃР»РµРґРЅРµРіРѕ РѕСЃС‚Р°РІР»РµРЅРЅРѕРіРѕ РѕС‚Р·С‹РІР° (РёСЃС‡РµР·Р°СЋС‰РёР№ РїРѕ РєР»РёРєСѓ РёР»Рё С‚Р°Р№РјРµСЂСѓ) -->
            <TextView
                android:id="@+id/tvLatestReviewNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                android:padding="12dp"
                android:background="@drawable/bg_badge_matched"
                android:textColor="#2E7D32"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
