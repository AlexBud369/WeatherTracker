<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Строка 1: Город и Статус -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_location"
                android:contentDescription="Город" />

            <TextView
                android:id="@+id/tvCardCity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Москва"
                android:textColor="#0F172A"
                android:textStyle="bold"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvCardStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_matched"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="Совпало"
                android:textColor="#2E7D32"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Строка 2: Заголовок и превью текста -->
        <TextView
            android:id="@+id/tvCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Точный прогноз на выходные"
            android:textColor="#334155"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCardSnippet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Прогноз был точным, солнечно и тепло..."
            android:textColor="#64748B"
            android:textSize="13sp" />

        <!-- Строка 3: Дата/время и кнопки Редактировать / Удалить -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCardDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="30.10.2026 10:45"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnCardEdit"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_edit"
                app:tint="#1E88E5"
                android:contentDescription="Редактировать" />

            <ImageButton
                android:id="@+id/btnCardDelete"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                app:tint="#EF4444"
                android:contentDescription="Удалить" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
