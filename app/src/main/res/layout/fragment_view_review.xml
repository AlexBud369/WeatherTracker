<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- РљР°СЂС‚РѕС‡РєР° РѕС‚Р·С‹РІР° -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Р—Р°РіРѕР»РѕРІРѕРє РѕС‚Р·С‹РІР° -->
                    <TextView
                        android:id="@+id/tvReviewTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="РўРѕС‡РЅС‹Р№ РїСЂРѕРіРЅРѕР· РЅР° РІС‹С…РѕРґРЅС‹Рµ"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A" />

                    <!-- РЎС‚Р°С‚СѓСЃ СЃРѕРІРїР°РґРµРЅРёСЏ (Р±РµР№РґР¶) -->
                    <TextView
                        android:id="@+id/tvReviewStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/bg_badge_matched"
                        android:text="РЎРѕРІРїР°Р»Рѕ"
                        android:textColor="#2E7D32"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <!-- Р“РѕСЂРѕРґ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_location"
                            android:contentDescription="Р“РѕСЂРѕРґ" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Р“РѕСЂРѕРґ: "
                            android:textColor="#64748B"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvReviewCity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="РњРѕСЃРєРІР°"
                            android:textColor="#0F172A"
                            android:textStyle="bold"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <!-- Р”Р°С‚Р° Рё РІСЂРµРјСЏ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_calendar"
                            app:tint="#64748B"
                            android:contentDescription="Р”Р°С‚Р°" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Р”Р°С‚Р° Рё РІСЂРµРјСЏ: "
                            android:textColor="#64748B"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvReviewDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30.10.2026 10:45"
                            android:textColor="#0F172A"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="#E2E8F0" />

                    <!-- РљРѕРјРјРµРЅС‚Р°СЂРёР№ -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="РўРµРєСЃС‚РѕРІС‹Р№ РєРѕРјРјРµРЅС‚Р°СЂРёР№:"
                        android:textColor="#64748B"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvReviewComment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="4dp"
                        android:text="РџСЂРѕРіРЅРѕР· Р±С‹Р» Р°Р±СЃРѕР»СЋС‚РЅРѕ С‚РѕС‡РЅС‹Рј..."
                        android:textColor="#334155"
                        android:textSize="15sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- РљРЅРѕРїРєРё РґРµР№СЃС‚РІРёР№ -->
            <Button
                android:id="@+id/btnEditReview"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:text="Р РµРґР°РєС‚РёСЂРѕРІР°С‚СЊ РѕС‚Р·С‹РІ"
                android:textSize="14sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:icon="@drawable/ic_edit"
                app:iconGravity="textStart" />

            <Button
                android:id="@+id/btnBackToList"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:text="Р’РµСЂРЅСѓС‚СЊСЃСЏ РЅР°Р·Р°Рґ"
                android:textSize="14sp"
                android:backgroundTint="#1E88E5" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
