<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Р—Р°РіРѕР»РѕРІРѕРє РѕС‚Р·С‹РІР° -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Р—Р°РіРѕР»РѕРІРѕРє РѕС‚Р·С‹РІР° *"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#334155" />

            <EditText
                android:id="@+id/etReviewTitle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_search_bar"
                android:hint="РќР°РїСЂРёРјРµСЂ: РџСЂРѕРіРЅРѕР· РІ РњРѕСЃРєРІРµ Р±С‹Р» С‚РѕС‡РЅС‹Рј"
                android:inputType="textCapSentences"
                android:paddingHorizontal="12dp"
                android:textColor="#0F172A"
                android:textSize="15sp" />

            <!-- Р“РѕСЂРѕРґ (РІС‹РїР°РґР°СЋС‰РёР№ СЃРїРёСЃРѕРє СЃ РїРѕРёСЃРєРѕРј) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Р“РѕСЂРѕРґ *"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#334155" />

            <AutoCompleteTextView
                android:id="@+id/actvCity"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_search_bar"
                android:hint="Р’С‹Р±РµСЂРёС‚Рµ РёР»Рё РІРІРµРґРёС‚Рµ РіРѕСЂРѕРґ"
                android:completionThreshold="1"
                android:inputType="textCapWords"
                android:paddingHorizontal="12dp"
                android:textColor="#0F172A"
                android:textSize="15sp" />

            <!-- Р”Р°С‚Р° Рё Р’СЂРµРјСЏ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Р”Р°С‚Р°: РєР°Р»РµРЅРґР°СЂСЊ -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Р”Р°С‚Р°"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#334155" />

                    <Button
                        android:id="@+id/btnPickDate"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:text="30.10.2026"
                        android:textSize="13sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        app:icon="@drawable/ic_calendar"
                        app:iconGravity="textStart" />
                </LinearLayout>

                <!-- Р’СЂРµРјСЏ -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Р’СЂРµРјСЏ"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#334155" />

                    <Button
                        android:id="@+id/btnPickTime"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:text="10:45"
                        android:textSize="13sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        app:icon="@drawable/ic_time"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </LinearLayout>

            <!-- РљРЅРѕРїРєР°/РїРµСЂРµРєР»СЋС‡Р°С‚РµР»СЊ: СЃРѕРІРїР°Р»Рѕ / РЅРµ СЃРѕРІРїР°Р»Рѕ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Р РµР·СѓР»СЊС‚Р°С‚ РїСЂРѕРіРЅРѕР·Р° *"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#334155" />

            <RadioGroup
                android:id="@+id/rgStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbMatched"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="РЎРѕРІРїР°Р»Рѕ"
                    android:textColor="#2E7D32"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbMismatched"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="РќРµ СЃРѕРІРїР°Р»Рѕ"
                    android:textColor="#D32F2F"
                    android:textStyle="bold" />
            </RadioGroup>

            <!-- РўРµРєСЃС‚РѕРІС‹Р№ РєРѕРјРјРµРЅС‚Р°СЂРёР№ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="РўРµРєСЃС‚РѕРІС‹Р№ РєРѕРјРјРµРЅС‚Р°СЂРёР№ *"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#334155" />

            <EditText
                android:id="@+id/etReviewComment"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_search_bar"
                android:gravity="top|start"
                android:hint="РћРїРёС€РёС‚Рµ РїРѕРіРѕРґСѓ РїРѕРґСЂРѕР±РЅРѕ: С‚РµРјРїРµСЂР°С‚СѓСЂСѓ, РѕСЃР°РґРєРё, РІРµС‚РµСЂ Рё СЃРѕРІРїР°РґРµРЅРёРµ СЃ РїСЂРѕРіРЅРѕР·РѕРј..."
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textColor="#0F172A"
                android:textSize="14sp" />

            <!-- РљРЅРѕРїРєРё: РЎРѕС…СЂР°РЅРёС‚СЊ Рё РћС‚РјРµРЅРёС‚СЊ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="РћС‚РјРµРЅРёС‚СЊ"
                    android:textSize="14sp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="РЎРѕС…СЂР°РЅРёС‚СЊ"
                    android:textSize="14sp"
                    android:backgroundTint="#1E88E5" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
