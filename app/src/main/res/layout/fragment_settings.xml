<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- РџРћР”Р РђР—Р”Р•Р›: РџР Р•Р”РЎРўРђР’Р›Р•РќРР• -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="РџР Р•Р”РЎРўРђР’Р›Р•РќРР•"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#1E88E5"
                android:letterSpacing="0.08" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- РЇР·С‹Рє -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="РЇР·С‹Рє РёРЅС‚РµСЂС„РµР№СЃР°"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#334155" />

                    <Spinner
                        android:id="@+id/spinnerLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_search_bar" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#F1F5F9" />

                    <!-- РўРµРјР°: РџРµСЂРµРєР»СЋС‡Р°С‚РµР»СЊ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="РўРµРјР° РѕС„РѕСЂРјР»РµРЅРёСЏ"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#334155" />

                            <TextView
                                android:id="@+id/tvThemeSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="РЎРІРµС‚Р»Р°СЏ С‚РµРјР°"
                                android:textSize="12sp"
                                android:textColor="#64748B" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchTheme"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- РџРћР”Р РђР—Р”Р•Р›: РџРћР“РћР”Рђ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="РџРћР“РћР”Рђ"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#1E88E5"
                android:letterSpacing="0.08" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- РўРµРјРїРµСЂР°С‚СѓСЂР°: Р¦РµР»СЊСЃРёР№ / Р¤Р°СЂРµРЅРіРµР№С‚ -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Р•РґРёРЅРёС†С‹ С‚РµРјРїРµСЂР°С‚СѓСЂС‹"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#334155" />

                    <RadioGroup
                        android:id="@+id/rgTemperature"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbCelsius"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="true"
                            android:text="В°C (Р¦РµР»СЊСЃРёР№)"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbFahrenheit"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="В°F (Р¤Р°СЂРµРЅРіРµР№С‚)"
                            android:textSize="13sp" />
                    </RadioGroup>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="#F1F5F9" />

                    <!-- РЎРєРѕСЂРѕСЃС‚СЊ РІРµС‚СЂР°: Рј/СЃ, РєРј/С‡, РјРёР»СЊ/С‡ -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="РЎРєРѕСЂРѕСЃС‚СЊ РІРµС‚СЂР°"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#334155" />

                    <RadioGroup
                        android:id="@+id/rgWind"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbWindMs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Рј/СЃ (РјРµС‚СЂС‹ РІ СЃРµРєСѓРЅРґСѓ)"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbWindKmh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="РєРј/С‡ (РєРёР»РѕРјРµС‚СЂС‹ РІ С‡Р°СЃ)"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbWindMph"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="РјРёР»СЊ/С‡ (РјРёР»Рё РІ С‡Р°СЃ)"
                            android:textSize="13sp" />
                    </RadioGroup>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="#F1F5F9" />

                    <!-- РђС‚РјРѕСЃС„РµСЂРЅРѕРµ РґР°РІР»РµРЅРёРµ -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="РђС‚РјРѕСЃС„РµСЂРЅРѕРµ РґР°РІР»РµРЅРёРµ"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#334155" />

                    <RadioGroup
                        android:id="@+id/rgPressure"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbPressureMm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="РјРј СЂС‚. СЃС‚. (РјРёР»Р»РёРјРµС‚СЂС‹ СЂС‚СѓС‚РЅРѕРіРѕ СЃС‚РѕР»Р±Р°)"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbPressureHpa"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="РіРџР° (РіРµРєС‚РѕРїР°СЃРєР°Р»Рё)"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbPressureMbar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="РјР±Р°СЂ (РјРёР»Р»РёР±Р°СЂС‹)"
                            android:textSize="13sp" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- РџРћР”Р РђР—Р”Р•Р›: РЈР’Р•Р”РћРњР›Р•РќРРЇ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="РЈР’Р•Р”РћРњР›Р•РќРРЇ"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#1E88E5"
                android:letterSpacing="0.08" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="РЈРІРµРґРѕРјР»РµРЅРёСЏ Рѕ РїРѕРіРѕРґРµ"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#334155" />

                        <TextView
                            android:id="@+id/tvNotificationStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="РІРєР». / РІС‹РєР»"
                            android:textSize="12sp"
                            android:textColor="#64748B" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchNotifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
