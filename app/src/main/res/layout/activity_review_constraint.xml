<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- ФИКСИРОВАННЫЙ заголовок -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Оставить отзыв"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp" />

    <!-- ПРОКРУЧИВАЕМАЯ форма: между заголовком и кнопкой Отменить -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_form"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintBottom_toTopOf="@id/btn_cancel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Внутренний ConstraintLayout — здесь и Barrier, и Guideline -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Guideline: вертикальная линия на 20% ширины -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.20" />

            <!-- Совпало / Не совпало (горизонтальная цепочка) -->
            <Button
                android:id="@+id/btn_match"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Совпало"
                android:layout_marginEnd="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_mismatch"
                app:layout_constraintHorizontal_chainStyle="spread" />

            <Button
                android:id="@+id/btn_mismatch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Не совпало"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/btn_match"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Barrier: нижняя граница двух кнопок -->
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="btn_match,btn_mismatch" />

            <!-- Заголовок отзыва (использует Guideline) -->
            <TextView
                android:id="@+id/label_review_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Заголовок отзыва"
                android:textSize="16sp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/barrier_buttons"
                app:layout_constraintStart_toEndOf="@id/guideline_start"
                app:layout_constraintEnd_toEndOf="parent" />

            <EditText
                android:id="@+id/et_review_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Введите заголовок"
                android:inputType="text"
                app:layout_constraintTop_toBottomOf="@id/label_review_title"
                app:layout_constraintStart_toEndOf="@id/guideline_start"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Город -->
            <TextView
                android:id="@+id/label_city"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Город"
                android:textSize="16sp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/et_review_title"
                app:layout_constraintStart_toEndOf="@id/guideline_start"
                app:layout_constraintEnd_toEndOf="parent" />

            <AutoCompleteTextView
                android:id="@+id/ac_city"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Начните вводить город"
                android:inputType="text"
                app:layout_constraintTop_toBottomOf="@id/label_city"
                app:layout_constraintStart_toEndOf="@id/guideline_start"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Дата -->
            <TextView
                android:id="@+id/label_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Дата"
                android:textSize="16sp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/ac_city"
                app:layout_constraintStart_toEndOf="@id/guideline_start"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btn_pick_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Выбрать дату"
                app:layout_constraintTop_toBottomOf="@id/label_date"
                app:layout_constraintStart_toEndOf="@id/guideline_start"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Время -->
            <TextView
                android:id="@+id/label_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Время"
                android:textSize="16sp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/btn_pick_date"
                app:layout_constraintStart_toEndOf="@id/guideline_start"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btn_pick_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Выбрать время"
                app:layout_constraintTop_toBottomOf="@id/label_time"
                app:layout_constraintStart_toEndOf="@id/guideline_start"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Комментарий: height=wrap_content (не 0dp!), иначе схлопнется -->
            <TextView
                android:id="@+id/label_comment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Комментарий"
                android:textSize="16sp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/btn_pick_time"
                app:layout_constraintStart_toEndOf="@id/guideline_start"
                app:layout_constraintEnd_toEndOf="parent" />

            <EditText
                android:id="@+id/et_comment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minLines="3"
                android:gravity="top"
                android:hint="Опишите, насколько прогноз совпал с реальностью"
                android:inputType="textMultiLine"
                android:layout_marginBottom="16dp"
                app:layout_constraintTop_toBottomOf="@id/label_comment"
                app:layout_constraintStart_toEndOf="@id/guideline_start"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ФИКСИРОВАННЫЕ Сохранить / Отменить -->
    <Button
        android:id="@+id/btn_cancel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Отменить"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_save"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <Button
        android:id="@+id/btn_save"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Сохранить"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toEndOf="@id/btn_cancel"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ФИКСИРОВАННАЯ нижняя навигация -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#EEEEEE"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button android:id="@+id/nav_weather"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Погода"
            style="?android:attr/borderlessButtonStyle" />

        <Button android:id="@+id/nav_forecast"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Прогноз"
            style="?android:attr/borderlessButtonStyle" />

        <Button android:id="@+id/nav_reviews"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Отзывы"
            style="?android:attr/borderlessButtonStyle" />

        <Button android:id="@+id/nav_settings"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Настройки"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>